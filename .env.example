# Copy this file to .env and fill in real values locally.
# .env is git-ignored — never commit real secrets.
# During mock-data phase, most of these can stay blank or use dummy values;
# the mock adapters should not require real credentials to run.

# ------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------
ENV=development                 # development | staging | production
USE_MOCK_ADAPTERS=true          # flips ingestion between mock/ and real/ adapters

# ------------------------------------------------------------------
# External data sources (leave blank until access is granted)
# ------------------------------------------------------------------
IMD_API_BASE_URL=
IMD_API_KEY=

ISRO_BHUVAN_API_BASE_URL=
ISRO_BHUVAN_API_KEY=

GSI_DATA_PORTAL_BASE_URL=
GSI_DATA_PORTAL_API_KEY=

APISETU_BASE_URL=https://apisetu.gov.in
APISETU_CLIENT_ID=
APISETU_CLIENT_SECRET=

# ------------------------------------------------------------------
# Database (PostgreSQL + PostGIS, per Phase 3 tech stack)
# ------------------------------------------------------------------
DATABASE_URL=postgresql://ner_ews_user:changeme@localhost:5432/ner_ews_dev
POSTGIS_ENABLED=true

# Object storage for raw data lake (local dev can point at MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_RAW=ner-ews-raw-dev
OBJECT_STORAGE_BUCKET_PROCESSED=ner-ews-processed-dev

# ------------------------------------------------------------------
# Streaming / message queue
# ------------------------------------------------------------------
KAFKA_BROKER_URL=localhost:9092
# or, if using RabbitMQ instead:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------
# Auth / API gateway
# ------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-real-env
JWT_EXPIRY_MINUTES=60
API_GATEWAY_PORT=8000

# ------------------------------------------------------------------
# Alerting / notification channels (Tier 0/1 — real keys only when authorized)
# ------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=            # e.g. govt-approved bulk SMS gateway
SMS_GATEWAY_API_KEY=
PUSH_NOTIFICATION_SERVER_KEY=
NOTIFICATION_DRY_RUN=true        # keep true until alert policy is signed off — logs instead of sends

# ------------------------------------------------------------------
# Maps
# ------------------------------------------------------------------
MAP_TILE_PROVIDER=               # e.g. MapLibre / GeoServer endpoint
MAP_TILE_API_KEY=

# ------------------------------------------------------------------
# Translation / multilingual service
# ------------------------------------------------------------------
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=

# ------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------
LOG_LEVEL=info
PROMETHEUS_METRICS_PORT=9090
